# Database — SQLite for local dev, PostgreSQL for production
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/gym_db"

# App
PORT=3000
NODE_ENV=development

# CORS — comma-separated allowed origins (* for dev only)
CORS_ORIGIN=*

# JWT — generate strong random secrets for production (min 32 chars)
JWT_SECRET=change_me_to_a_random_32_char_secret
JWT_REFRESH_SECRET=change_me_to_another_random_32_char_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
