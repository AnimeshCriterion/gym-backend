    },

    {
      "name": "🔄 Subscriptions",
      "item": [

        {
          "name": "Get My Subscriptions",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/subscriptions/my" },
            "description": "Any role — returns caller's own subscriptions."
          }
        },

        {
          "name": "Get All Subscriptions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/subscriptions?status=ACTIVE&userId={{user_id}}&branchId={{branch_id}}&page=1&limit=20",
              "query": [
                { "key": "status",   "value": "ACTIVE",          "description": "ACTIVE | EXPIRED | CANCELLED | PENDING | FROZEN", "disabled": false },
                { "key": "userId",   "value": "{{user_id}}",     "disabled": true },
                { "key": "branchId", "value": "{{branch_id}}",   "disabled": true },
                { "key": "page",     "value": "1" },
                { "key": "limit",    "value": "20" }
              ]
            },
            "description": "ORG_ADMIN / BRANCH_MANAGER."
          }
        },

        {
          "name": "Get Subscription by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/subscriptions/{{subscription_id}}" },
            "description": "ORG_ADMIN / BRANCH_MANAGER / TRAINER (read-only). Includes renewal logs and payments."
          }
        },

        {
          "name": "Create Subscription",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "var json = pm.response.json();",
            "if (json.success && json.data) {",
            "    pm.environment.set('subscription_id', json.data.id);",
            "    console.log('✅ subscription_id saved: ' + json.data.id);",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"userId\": \"{{user_id}}\",\n  \"planId\": \"{{plan_id}}\",\n  \"branchId\": \"{{branch_id}}\",\n  \"startDate\": \"2026-05-06T00:00:00.000Z\",\n  \"autoRenew\": true,\n  \"notes\": \"First subscription\"\n}"
            },
            "url": { "raw": "{{base_url}}/subscriptions" },
            "description": "ORG_ADMIN / BRANCH_MANAGER. Auto-creates a PENDING payment record."
          }
        },

        {
          "name": "Cancel Subscription",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{base_url}}/subscriptions/{{subscription_id}}/cancel" },
            "description": "No body needed. Sets status = CANCELLED and autoRenew = false."
          }
        },

        {
          "name": "Freeze Subscription",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"freezeStart\": \"2026-05-10T00:00:00.000Z\",\n  \"freezeEnd\": \"2026-05-15T00:00:00.000Z\"\n}"
            },
            "url": { "raw": "{{base_url}}/subscriptions/{{subscription_id}}/freeze" },
            "description": "Extends endDate by the number of frozen days. Respects maxFreezeDays from the plan."
          }
        },

        {
          "name": "Unfreeze Subscription",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{base_url}}/subscriptions/{{subscription_id}}/unfreeze" },
            "description": "No body needed. Sets status back to ACTIVE, clears freeze dates."
          }
        },

        {
          "name": "Toggle Auto-Renew",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"autoRenew\": false\n}"
            },
            "url": { "raw": "{{base_url}}/subscriptions/{{subscription_id}}/auto-renew" }
          }
        }

      ]
    },

