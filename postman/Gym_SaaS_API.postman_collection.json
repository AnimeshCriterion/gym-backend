{
  "info": {
    "_postman_id": "gym-saas-api-v1",
    "name": "🏋️ Gym SaaS API",
    "description": "Complete API collection for Gym SaaS backend.\n\n**Setup:**\n1. Import both the collection and the environment file.\n2. Select the **Gym SaaS — Local** environment.\n3. Run **Login** — tokens are saved automatically.\n4. All subsequent requests use `{{access_token}}` from the environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api/v1", "type": "string" }
  ],
  "item": [

    {
      "name": "🔑 Auth",
      "item": [

        {
          "name": "Register Organization",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "var json = pm.response.json();",
            "if (json.success && json.data) {",
            "    pm.environment.set('access_token',  json.data.accessToken);",
            "    pm.environment.set('refresh_token', json.data.refreshToken);",
            "    pm.environment.set('org_id',        json.data.organization.id);",
            "    console.log('Tokens + org_id saved');",
            "}"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"orgName\": \"FitLife Gym\",\n  \"orgSlug\": \"fitlife-gym\",\n  \"orgEmail\": \"info@fitlife.com\",\n  \"orgPhone\": \"9876543210\",\n  \"adminName\": \"Animesh\",\n  \"adminEmail\": \"animesh@fitlife.com\",\n  \"adminPassword\": \"password123\",\n  \"adminPhone\": \"9876543211\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Registers a new gym + first ORG_ADMIN. Starts a 7-day free trial automatically."
          }
        },

        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "var json = pm.response.json();",
            "if (json.success && json.data) {",
            "    pm.environment.set('access_token',  json.data.accessToken);",
            "    pm.environment.set('refresh_token', json.data.refreshToken);",
            "    if (json.data.user.organizationId) pm.environment.set('org_id',    json.data.user.organizationId);",
            "    if (json.data.user.branchId)       pm.environment.set('branch_id', json.data.user.branchId);",
            "    console.log('Tokens saved | role: ' + json.data.user.role);",
            "}"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"gymadmin@fitzone.com\",\n  \"password\": \"admin@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Seed credentials:\n- Admin: gymadmin@fitzone.com / admin@123\n- Member (sub): john@fitzone.com / member@123\n- Member (no sub): jane@fitzone.com / member@123"
          }
        },

        {
          "name": "Refresh Token",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "var json = pm.response.json();",
            "if (json.success && json.data) {",
            "    pm.environment.set('access_token',  json.data.accessToken);",
            "    pm.environment.set('refresh_token', json.data.refreshToken);",
            "    console.log('Tokens rotated');",
            "}"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            }
          }
        },

        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            }
          }
        },

        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Returns fresh user data from DB."
          }
        },

        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"name\": \"Updated Name\",\n  \"phone\": \"9876543210\",\n  \"gender\": \"Male\",\n  \"address\": \"123 New Street, Mumbai\",\n  \"emergencyContact\": \"9876543211\",\n  \"dateOfBirth\": \"1995-06-15\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Any role. Cannot change email or role."
          }
        },

        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"currentPassword\": \"admin@123\",\n  \"newPassword\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/change-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "change-password"]
            },
            "description": "Invalidates all refresh tokens on all devices."
          }
        }

      ]
    },

