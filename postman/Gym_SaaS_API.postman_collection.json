            "description": "ORG_ADMIN / BRANCH_MANAGER."
          }
        },

        {
          "name": "Get Subscription by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/subscriptions/{{subscription_id}}",
              "host": ["{{base_url}}"],
              "path": ["subscriptions", "{{subscription_id}}"]
            },
            "description": "Includes renewal logs + payments. TRAINER has read-only access."
          }
        },

        {
          "name": "Create Subscription",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "var json = pm.response.json();",
            "if (json.success && json.data) {",
            "    pm.environment.set('subscription_id', json.data.id);",
            "    console.log('subscription_id saved: ' + json.data.id);",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"userId\": \"{{user_id}}\",\n  \"planId\": \"{{plan_id}}\",\n  \"branchId\": \"{{branch_id}}\",\n  \"startDate\": \"2026-05-06T00:00:00.000Z\",\n  \"autoRenew\": true,\n  \"notes\": \"First subscription\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/subscriptions",
              "host": ["{{base_url}}"],
              "path": ["subscriptions"]
            },
            "description": "ORG_ADMIN / BRANCH_MANAGER. Auto-creates a PENDING payment."
          }
        },

        {
          "name": "Cancel Subscription",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{base_url}}/subscriptions/{{subscription_id}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["subscriptions", "{{subscription_id}}", "cancel"]
            },
            "description": "No body. Sets status = CANCELLED and autoRenew = false."
          }
        },

        {
