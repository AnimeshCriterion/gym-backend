            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/subscriptions?status=ACTIVE&page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["subscriptions"],
              "query": [
                { "key": "status",   "value": "ACTIVE",        "description": "ACTIVE | EXPIRED | CANCELLED | PENDING | FROZEN" },
                { "key": "userId",   "value": "{{user_id}}",   "disabled": true },
                { "key": "branchId", "value": "{{branch_id}}", "disabled": true },
                { "key": "page",     "value": "1" },
                { "key": "limit",    "value": "20" }
              ]
